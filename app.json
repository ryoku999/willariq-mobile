{
  "expo": {
    "name": "willariq",
    "slug": "willariq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/willariq-icon.png",
    "scheme": "willariq",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10263C",
        "foregroundImage": "./assets/images/willariq-adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.ryoku999steam.willariq"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Willariq seleccione evidencias fotográficas.",
          "cameraPermission": "Permite que Willariq tome fotografías de la incidencia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Willariq obtenga la ubicación de la incidencia."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91ff8bf0-3d82-4fb9-af1b-7abac2fd9990"
      }
    },
    "owner": "ryoku999s-team"
  }
}
